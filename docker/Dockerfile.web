# Node 24 to match the Playwright image the scraper runs on, and CI.
ARG NODE_IMAGE=node:24-alpine3.24

# Shared by deps + builder. corepack picks the pnpm version from "packageManager" in the
# root package.json, which both stages copy before running pnpm.
FROM ${NODE_IMAGE} AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

# Stage 1: Install dependencies
FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile

# Stage 2: Build
FROM base AS builder

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/ apps/web/
COPY packages/shared/ packages/shared/
RUN pnpm --filter @mtg-au/web build

# Stage 3: Minimal runtime image — no node_modules, no pnpm needed
FROM ${NODE_IMAGE} AS runner
RUN addgroup -g 1001 -S web && adduser -u 1001 -S web -G web
WORKDIR /app

COPY --from=builder --chown=web:web /app/apps/web/.next/standalone ./
COPY --from=builder --chown=web:web /app/apps/web/.next/static apps/web/.next/static
COPY --from=builder --chown=web:web /app/apps/web/public apps/web/public

USER 1001:1001
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
