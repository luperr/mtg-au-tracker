# Scraper production image.
# Must use the Playwright base image — it ships with Chromium and all OS dependencies.
# IMPORTANT: version must match "playwright" in apps/scraper/package.json.
FROM mcr.microsoft.com/playwright:v1.64.1-noble

WORKDIR /app

# pnpm version comes from "packageManager" in the root package.json — the one place it's set.
COPY package.json ./
RUN npm install -g "$(node -p "require('./package.json').packageManager")"

# Install dependencies (layer-cached separately from source)
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/scraper/package.json apps/scraper/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile

# Copy source
COPY apps/scraper/ apps/scraper/
COPY packages/shared/ packages/shared/

# Run as non-root user
RUN groupadd -g 1002 scraper && useradd -u 1002 -g scraper -m -s /bin/bash scraper
RUN chown -R scraper:scraper /app
USER 1002:1002

CMD ["pnpm", "--filter", "@mtg-au/scraper", "start"]
