# Scrymarket environment
#
# Copy to .env and fill in the values marked REQUIRED:
#   cp .env.example .env
#
# Docker Compose reads this file from the repo root and interpolates ${VAR} into
# docker-compose.yml / docker-compose.prod.yml. Everything with a default below can
# be left unset — the default in the table is what the code actually falls back to.
#
# Every scraper variable here is read in exactly one place:
# apps/scraper/src/lib/config.ts. If you add a variable, add it there and here.

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — REQUIRED, never commit real values
# ─────────────────────────────────────────────────────────────────────────────

# Postgres password. Compose builds DATABASE_URL from this for both services.
DB_PASSWORD=changeme

# eBay Browse API credentials (developer.ebay.com → your app's keyset).
# Without these the eBay import is the only thing that fails; stores still scrape.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay Partner Network (affiliate) — web app only, read at runtime by the root layout.
#
# Campaign id from the EPN dashboard. Leave unset to turn affiliate rewriting off:
# outbound eBay links then render exactly as they did before, and nothing is earned.
EBAY_AFFILIATE_CAMPAIGN_ID=
#
# Rotation id for the eBay AU site. Defaults to 705-53470-19255-0 (siteid 15) when
# unset. Confirm it against a link generated in the EPN dashboard before going live —
# a wrong rotation id loses attribution silently instead of erroring.
EBAY_AFFILIATE_ROTATION_ID=

# Cloudflare Tunnel token — prod only, from the Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# GitHub token used by the web app. Read-only, no scopes needed beyond public data.
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Only needed to run scripts from the host, outside Compose. Inside Compose the
# services build their own connection string from DB_PASSWORD and the `db` service.
DATABASE_URL=postgresql://mtg:changeme@localhost:5432/mtg_tracker

# trace | debug | info | warn | error — pino level for both services.
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Deployment (prod only — see docs/prod-release.md)
# ─────────────────────────────────────────────────────────────────────────────

# Registry + namespace for the prod images. Single lever for a future ECR swap.
IMAGE_REGISTRY=ghcr.io/luperr

# Which image tag to run. `main-<sha>` pins or rolls back; scripts/deploy.sh sets
# this from its first argument.
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# Scheduling — all crons run in Australia/Sydney (hard-coded, not configurable)
# ─────────────────────────────────────────────────────────────────────────────

SCRAPE_CRON_SCRYFALL=0 3 * * *
SCRAPE_CRON_STORES=0 5 * * *
SCRAPE_CRON_EBAY=0 6 * * *
SCRAPE_CRON_MARKET=0 7 * * *

# Market stats are PAUSED unless this is exactly "true". They read the whole of
# price_history, which saturates the production disks for hours. See CLAUDE.md
# before turning this on.
#
# Note this does NOT gate set_card_daily: that refresh is incremental and runs every
# night regardless, because the card price chart and the set pages both read it.
MARKET_STATS_ENABLED=

# How many days of set_card_daily to keep. It gains ~29k rows/day, so without a bound
# it becomes a second price_history. price_history is still the source of truth, so
# raising this and re-running refresh:set-card-daily backfills the extra days.
SET_CARD_DAILY_RETENTION_DAYS=365

# ─────────────────────────────────────────────────────────────────────────────
# eBay import
# ─────────────────────────────────────────────────────────────────────────────

# production | sandbox
EBAY_ENV=production

# Max searches per run. The production app key allows ~5,000 calls/day, resetting
# at midnight Pacific — this is the quota-filling target, deliberately under it.
EBAY_DAILY_TARGET=4500

EBAY_PAGES_PER_SET=5
EBAY_PAGES_PER_CARD=1

# ─────────────────────────────────────────────────────────────────────────────
# Scraper tuning
# ─────────────────────────────────────────────────────────────────────────────

# Stores scraped in parallel by runAllStores(). Kept low because a store that hits
# a bot challenge launches its own Chromium, and this bounds the live browser count.
STORE_CONCURRENCY=3

# CrystalCommerce categories in flight. Do NOT raise above 3 without re-measuring:
# 4-wide returned a 503, and the store's latency roughly doubles under parallel load.
CC_CONCURRENCY=3

# Days between full re-scans of every CrystalCommerce category / MTG Mate set code.
# Between full scans only known-good targets are re-probed.
CC_FULL_SCAN_DAYS=7
MTGMATE_FULL_SCAN_DAYS=7

# Sent as User-Agent on all plain-fetch scraping.
USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:120.0) Gecko/20100101 Firefox/120.0

# ─────────────────────────────────────────────────────────────────────────────
# External data
# ─────────────────────────────────────────────────────────────────────────────

SCRYFALL_BULK_URL=https://api.scryfall.com/bulk-data

# Where the bulk file is downloaded to. /tmp is a tmpfs in the prod container, so
# this file (624MB uncompressed, measured 2026-08-22) is held in RAM and counts
# against the scraper's 2g mem_limit — which is why the tmpfs is size-capped and
# the heap is capped below it. Override only if you have somewhere better to put it;
# the scraper runs read_only, so it must be a writable mount owned by uid 1002.
SCRYFALL_OUTPUT_DIR=/tmp/mtg-scraper

# AUD_USD_RATE is deliberately absent. It feeds getAudPerUsd() in packages/shared,
# which currently has no callers — setting it changes nothing. Re-add it here when
# the live-rate roadmap item lands and something actually reads it.
